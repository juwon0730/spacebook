rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인했고, 구글이 확인한 이메일이며, 문서 주인과 같은 사람인지 확인
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // 앱이 쓰는 문서 이름만 허용: main4(책장 정보), b_책ID(노트)
    function validId(docId) {
      return docId.matches('^(main4|b_[a-z0-9]{1,40})$');
    }

    // 앱이 쓰는 모양의 데이터만 허용
    function validData() {
      return request.resource.data.keys().hasOnly(['state', 'board', 'updatedAt'])
        && request.resource.data.updatedAt is int;
    }

    // 각자 자기 기록만 읽고 쓸 수 있어요: users/{내 uid}/data/{문서}
    match /users/{uid}/data/{docId} {
      allow read, delete: if isOwner(uid) && validId(docId);
      allow create, update: if isOwner(uid) && validId(docId) && validData();
    }

    // 그 밖의 모든 경로는 누구도 읽거나 쓸 수 없어요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
